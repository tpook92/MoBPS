target_string <- "/lustre/nobackup/SHARED/mobps_topigs"
# Get a list of all .R files in the directory and subdirectories
files <- list.files(directory, pattern = "\\.R$")
setwd(directory)
# Loop through each .R file and search for the string
for (file in files) {
# Try to read the file as text
try({
content <- readLines(file, warn = FALSE)
# Check if the target string is in the file content
if (any(grepl(target_string, content))) {
cat("Found in:", file, "\n")
}
}, silent = TRUE)
}
