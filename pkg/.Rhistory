}
data[[1]][1:5,]
data[[2]][1:5,]
# intercepts
cor_tab = matrix(0, nrow = 4, ncol = 4)
for(index in 1:4){
for(index2 in 1:4){
keeps = intersect(data[[index]][,2], data[[index2]][,2])
keep1 = data[[index]][,2] %in% keeps
keep2 = data[[index2]][,2] %in% keeps
plot(data[[index]][,3][keep1], data[[index2]][,3][keep2])
cor_tab[index,index2] = cor(as.numeric(data[[index]][,3][keep1]), as.numeric(data[[index2]][,3][keep2]))
}
}
# slopes
