par(mfrow = c(2,1))
time = 10
standard = TRUE
for(parity in 0:3){
dat = read.table(paste0("sln_file_THI_LSM_", parity))
activ = dat[,1]==time
if(standard){
correction = mean(dat[activ,3][dat[activ,2] %in% 45:55])
} else{
correction = 0
}
if(parity == 0){
plot(dat[activ,2], dat[activ,3] - correction, xlab = "THI", ylab = "effect on CR",
type = "l", col = parity + 1, lwd = 2, ylim = c(-30,10),
main = "LSM")
} else{
lines(dat[activ,2], dat[activ,3]- correction, xlab = "THI", ylab = "effect on CR",
type = "l", col = parity + 1, lwd = 2)
}
}
for(parity in 0:3){
dat = read.table(paste0("sln_file_THI_BSM_", parity))
activ = dat[,2]==time
if(parity == 0){
plot(c(0,60), c(0,0), xlab = "THI", ylab = "effect on CR",
type = "l", col = parity + 1, lwd = 2, ylim = c(-30,10),
xlim = c(24,74),
main = "BSM")
x = seq(60,86)
y = ((x-60)/13.75) ^ 2* dat[activ,5]
lines(x, y, col = parity + 1, lwd = 2)
} else{
lines(c(0,60), c(0,0), xlab = "THI", ylab = "effect on CR",
type = "l", col = parity + 1, lwd = 2, ylim = c(-30,10),
xlim = c(24,74))
x = seq(60,86)
y = ((x-60)/13.75) ^ 2* dat[activ,5]
lines(x, y, col = parity + 1, lwd = 2)  }
}
